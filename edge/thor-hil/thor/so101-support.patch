+
+def get_action_so101_sft_dataset(
+    *,
+    root: str,
+    fps: float = 30.0,
+    chunk_length: int = 32,
+    mode: str = "wam",
+    use_state: bool = True,
+    action_normalization: str | None = "minmax",
+    split: str = "train",
+    val_ratio: float = 0.01,
+    seed: int = 0,
+    resolution: str | int = "480",
+    max_action_dim: int = 64,
+    tokenizer_config: dict | None = None,
+    cfg_dropout_rate: float = 0.1,
+    append_viewpoint_info: bool = True,
+    append_duration_fps_timestamps: bool = True,
+    append_resolution_info: bool = True,
+    append_idle_frames: bool = False,
+    format_prompt_as_json: bool = False,
+    iterable_shuffle: bool = False,
+    episode_shuffle_seed: int = 42,
+    keep_tasks: tuple[str, ...] | None = None,
+    max_episodes_per_task: int | None = None,
+) -> Dataset:
+    """Build the SO-101 action SFT dataset: ``action_space="joint_pos"`` (6D) +
+    ``use_state`` (row 0 = current state), ``concat_view`` front-over-overhead
+    video, chunk_length 32, minmax-normalized against SO-101's ``.pos``
+    calibration bounds -- mirrors DROID's ``joint_pos``/``use_state`` recipe,
+    the closest reference shape to a single-arm real/sim-robot embodiment.
+
+    Reads ``root`` (a local LeRobot v3.0 dir, schema-matching
+    ``5hadytru/so101_bench_real_2`` / ``5hadytru/so101_bench_sim_6``) as a
+    single flat dataset via parquet + video, windowed per-episode.
+    """
+    dataset: Dataset = SO101LeRobotDataset(
+        root=root,
+        fps=fps,
+        chunk_length=chunk_length,
+        mode=mode,
+        use_state=use_state,
+        action_normalization=action_normalization,
+        split=split,
+        val_ratio=val_ratio,
+        seed=seed,
+        keep_tasks=keep_tasks,
+        max_episodes_per_task=max_episodes_per_task,
+    )
+    transform = ActionTransformPipeline(
+        tokenizer_config=tokenizer_config,
+        cfg_dropout_rate=cfg_dropout_rate,
+        max_action_dim=max_action_dim,
+        append_viewpoint_info=append_viewpoint_info,
+        append_duration_fps_timestamps=append_duration_fps_timestamps,
+        append_resolution_info=append_resolution_info,
+        append_idle_frames=append_idle_frames,
+        format_prompt_as_json=format_prompt_as_json,
+    )
+    sft = ActionSFTDataset(dataset, transform, resolution)
+    if iterable_shuffle:
+        return ActionIterableShuffleDataset(sft, seed=episode_shuffle_seed)
+    return sft
+
+
+# Embodiment tags read by cosmos_framework.scripts.export_model
+# (_build_edge_policy_metadata) to fill the `policy.domain_name` field of an Edge
+# export's checkpoint.json. The resolver probes the dataset target for
+# `EMBODIMENT_TYPE`; these factories are functions rather than classes, so the
+# attribute is attached here. Values must match cosmos_framework.data.generator
+# .action.domain_utils (so101 -> domain 22, droid_lerobot -> domain 8).
