+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: OpenMDW-1.1
+
+"""``action_policy_so101_nano`` — Cosmos3-Nano SO-101 action-policy SFT recipe.
+
+Mirrors the upstream reference ``action_policy_droid_nano`` /
+``action_policy_libero_nano`` recipes (same ``mot_fsdp`` + ``PackingDataLoader``
++ ``RankPartitionedDataLoader`` stack, same action-head training/skip-loading
+convention), in this repo's current ``data.generator.action`` namespace (post
+``vfm`` -> ``generator`` rename), for a dataset that does not exist in either
+reference recipe: any schema-matching SO-101 LeRobot v3.0 dataset (e.g.
+``5hadytru/so101_bench_real_2``, ``5hadytru/so101_bench_sim_6``; SO-101,
+6-DOF single arm).
+
+Feeds ``SO101LeRobotDataset`` (``action_space='joint_pos'`` 6D + ``use_state``,
+minmax-normalized against SO-101's ``.pos`` calibration bounds, ``concat_view``
+front-over-overhead 480p video, chunk_length 32 — matching DROID's joint_pos
+config, the closest reference shape to a single-arm real/sim-robot embodiment)
+through ``ActionTransformPipeline``, and trains the generation + action heads
+from the public ``nvidia/Cosmos3-Nano`` base.
+
+Usage (1 node, 8 GPU)::
+
+    SO101_ROOT=/path/to/so101_bench_real_2 \\
+    BASE_CHECKPOINT_PATH=<Cosmos3-Nano DCP dir> \\
+    WAN_VAE_PATH=<Wan2.2_VAE.pth> \\
+    torchrun --nproc_per_node=8 -m cosmos_framework.scripts.train \\
+        --sft-toml examples/toml/sft_config/action_policy_so101_nano.toml
+
+See docs/so101_policy_finetune.md for the full pipeline (checkpoint
+conversion, --dryrun, export, serving via action_policy_server_robolab.py
+--domain-name so101 --arm-joint-dim 5, and evaluation via so101_bench).
+"""
+
+import copy
+
+from hydra.core.config_store import ConfigStore
+
+from cosmos_framework.configs.base.experiment.sft.models.nano_model_config import NANO_MODEL_CONFIG
+from cosmos_framework.data.generator.action.datasets.action_sft_dataset import get_action_so101_sft_dataset
+from cosmos_framework.data.generator.joint_dataloader import (
+    PackingDataLoader,
+    RankPartitionedDataLoader,
+)
+from cosmos_framework.utils.lazy_config import LazyCall as L
+from cosmos_framework.utils.lazy_config import LazyDict
+
+cs = ConfigStore.instance()
+
+
+action_policy_so101_nano = LazyDict(
+    dict(
+        defaults=[
+            {"override /model": "mot_fsdp"},
+            {"override /data_train": None},
+            {"override /data_val": None},
+            # FusedAdam with fp32 master_weights + eps 1e-8 (bf16 params + eps 1e-6
+            # diverged on the action loss in both DROID and LIBERO reference runs).
+            {"override /optimizer": "fusedadamw"},
+            {"override /scheduler": "lambdalinear"},  # linear LR decay
+            {"override /checkpoint": "s3"},
+            {"override /callbacks": ["basic", "optimization", "job_monitor"]},
+            {"override /ema": "power"},
+            {"override /tokenizer": "wan2pt2_tokenizer"},
+            {"override /sound_tokenizer": None},
+            {"override /vlm_config": None},
+            {"override /ckpt_type": "dcp"},
+            "_self_",
+        ],
+        job=dict(
+            project="cosmos3_action",
+            group="action_sft",
+            name="action_policy_so101_nano",
+            wandb_mode="disabled",
+        ),
+        model=dict(
+            config=copy.deepcopy(NANO_MODEL_CONFIG),  # action_gen=True, max_action_dim=64
+        ),
+        optimizer=dict(
+            betas=[0.9, 0.99],
+            eps=1.0e-08,
+            fused=True,  # popped by build_optimizer for FusedAdam (fused by construction)
+            # Train the generation + action heads.
+            keys_to_select=[
+                "moe_gen",
+                "time_embedder",
+                "vae2llm",
+                "llm2vae",
+                "action2llm",
+                "llm2action",
+                "action_modality_embed",
+            ],
+            lr=5.0e-05,  # LIBERO-10-scale LR (SO-101's 4367 episodes is much closer to
+            # libero_10 than to DROID's full dataset; DROID's lr=2e-4 was tuned for
+            # global batch 8192).
+            lr_multipliers={
+                "action2llm": 5.0,
+                "llm2action": 5.0,
+                "action_modality_embed": 5.0,
+            },
+            optimizer_type="FusedAdam",
+            weight_decay=0.05,
+        ),
+        scheduler=dict(
+            lr_scheduler_type="LambdaLinear",
+            cycle_lengths=[100],  # smoke: 100 iters (real run sets via TOML)
+            f_max=[1.0],
+            f_min=[0.0],
+            f_start=[1.0e-06],
+            verbosity_interval=0,
+            warm_up_steps=[0],  # smoke (real run sets via TOML)
+        ),
+        trainer=dict(
+            distributed_parallelism="fsdp",
+            grad_accum_iter=1,  # real run sets via TOML
+            logging_iter=1,
+            max_iter=100,  # smoke
+            max_val_iter=None,
+            run_validation=False,
+            run_validation_on_start=False,
+            save_zero_checkpoint=False,
+            seed=42,
+            timeout_period=999999999,
+            validation_iter=100,
+            compile_config=dict(recompile_limit=8, use_duck_shape=False),
+            cudnn=dict(benchmark=True, deterministic=False),
+            ddp=dict(broadcast_buffers=True, find_unused_parameters=False, static_graph=True),
+            grad_scaler_args=dict(enabled=False),
+            callbacks=dict(
+                dataloader_speed=dict(every_n=100, save_s3=False, step_size=1),
+                device_monitor=dict(
+                    every_n=200, log_memory_detail=True, save_s3=False, step_size=1, upload_every_n_mul=5
+                ),
+                grad_clip=dict(clip_norm=1.0, force_finite=True),
+                heart_beat=dict(every_n=200, save_s3=False, step_size=1, update_interval_in_minute=20),
+                iter_speed=dict(every_n=1, hit_thres=50, save_s3=False, save_s3_every_log_n=500),
+                low_precision=dict(update_iter=1),
+                manual_gc=dict(every_n=5, gc_level=1, warm_up=1),
+                param_count=dict(save_s3=False),
+                skip_nan_step=dict(max_consecutive_nan=100),
+                training_stats=dict(log_freq=100),
+            ),
+        ),
+        checkpoint=dict(
+            broadcast_via_filesystem=False,
+            dcp_async_mode_enabled=False,
+            enable_gcs_patch_in_boto3=True,
+            keys_not_to_resume=[],
+            # Skip net_ema. (EMA warm-starts from net, see dcp.py) and the action
+            # heads, so they init fresh from the base — matching both DROID's and
+            # LIBERO's reference recipes: the public Cosmos3-Nano base has no
+            # SO-101-trained action heads either.
+            keys_to_skip_loading=[
+                "net_ema.",
+                "action2llm",
+                "llm2action",
+                "action_modality_embed",
+                "action_pos_embed",
+            ],
+            load_ema_to_reg=False,
+            load_path="???",  # Cosmos3-Nano DCP dir; supply via TOML/env
+            load_training_state=False,
+            only_load_scheduler_state=False,
+            save_iter=100,
+            strict_resume=False,  # base init: tolerate key set differences
+            verbose=True,
+            hf_export=dict(
+                enabled=False,
+                export_every_n=1,
+                hf_repo_id=None,
+                upload_to_object_store=dict(bucket="", credentials="", enabled=False),
+            ),
+            jit=dict(device="cuda", dtype="bfloat16", enabled=False, input_shape=None, strict=True),
+            load_from_object_store=dict(bucket="", credentials="", enabled=False),
+            save_to_object_store=dict(bucket="", credentials="", enabled=False),
+        ),
+        dataloader_train=L(PackingDataLoader)(
+            audio_sample_rate=48000,
+            dataset_name="action_so101",
+            max_samples_per_batch=32,  # per rank; real run sets parallelism via TOML
+            max_sequence_length=None,  # None disables token packing (TOML can't express null)
+            patch_spatial=2,
+            sound_latent_fps=0,
+            tokenizer_spatial_compression_factor=16,
+            tokenizer_temporal_compression_factor=4,
+            dataloader=L(RankPartitionedDataLoader)(
+                batch_size=1,
+                in_order=False,
+                num_workers=8,  # host-CPU-bound; lower via CLI on smaller hosts
+                persistent_workers=True,
+                pin_memory=True,
+                prefetch_factor=4,
+                sampler=None,
+                # Shuffling is handled by the dataset (iterable_shuffle=True below):
+                # ActionIterableShuffleDataset streams rank x worker-sharded, episode-order-
+                # shuffled, sequential-within-episode (see action_sft_dataset.py).
+                datasets=dict(
+                    so101=dict(
+                        ratio=1,
+                        dataset=L(get_action_so101_sft_dataset)(
+                            # Local LeRobot v3.0 dir for 5hadytru/so101_bench_real_2. Use:
+                            #   uvx hf@latest download --repo-type dataset 5hadytru/so101_bench_real_2 \\
+                            #       --local-dir <dir>   # SO101_ROOT=<dir>
+                            root="${oc.env:SO101_ROOT}",
+                            fps=30.0,
+                            chunk_length=32,
+                            mode="wam",
+                            use_state=True,
+                            action_normalization="minmax",
+                            val_ratio=0.01,
+                            iterable_shuffle=True,
+                            episode_shuffle_seed=42,
+                            resolution="480",  # dataset is native 480x640 per camera
+                            max_action_dim="${model.config.max_action_dim}",
+                            cfg_dropout_rate=0.1,
+                            tokenizer_config="${model.config.vlm_config.tokenizer}",
+                            format_prompt_as_json=False,
+                        ),
+                    ),
+                ),
+            ),
+        ),
+        dataloader_val=None,
+        upload_reproducible_setup=False,
+    ),
+    flags={"allow_objects": True},
+)
+
+
+# ---------------------------------------------------------------------------
+# Focused 5-instruction variant.
+#
+# The full so101_bench_sim_6 root is 2228 episodes over 748 instructions, but
+# support per instruction is thin: the median instruction has 3 episodes, and
+# 89.5% of frames belong to the "Place ... in the plastic bin" family (875 of
+# them under the single string "Place each object in the plastic bin"). Training
+# 6000 iters at global batch 32 over 1.25M frames covers 0.15 of ONE epoch, so
+# no instruction is ever seen enough times to learn its grasp.
+#
+# This variant restricts the dataset to the five single-object bin-placement
+# instructions that have the most episodes (97 total, 35,132 frames). One epoch
+# is then 1098 iters instead of 39,027 -- 13.3 h instead of 20 days -- which
+# makes multi-epoch training and same-day iteration possible on one GPU.
+# val_ratio 0.10 holds out ~10 episodes for honest eval.
+# ---------------------------------------------------------------------------
+
+SO101_FOCUS5_TASKS = (
+    "Place the green shoes in the plastic bin",       # 25 episodes
+    "Place the cardboard box in the plastic bin",     # 18
+    "Place the altoids container in the plastic bin",  # 18
+    "Place the flower pot in the plastic bin",        # 18
+    "Place the cooking spoon in the plastic bin",     # 18
+)
+
+action_policy_so101_nano_focus5 = copy.deepcopy(action_policy_so101_nano)
+_focus_ds = action_policy_so101_nano_focus5["dataloader_train"]["dataloader"]["datasets"]["so101"]["dataset"]
+_focus_ds["keep_tasks"] = SO101_FOCUS5_TASKS
+_focus_ds["val_ratio"] = 0.10
+
+
+# ---------------------------------------------------------------------------
+# focus5 + clutter: the same five single-object instructions plus the dataset's
+# one multi-object instruction, capped so it cannot swamp them.
+#
+# Motivation: the focus5 policy scores 0/53 on cluttered 4-object scenes, and
+# the training set contains no cluttered scenes for those instructions at all.
+# `Place each object in the plastic bin` is 875 episodes / 693,885 frames of
+# exactly that, already present in the dataset and excluded by keep_tasks.
+#
+# Uncapped it is 95% of the mix and one epoch becomes ~16,800 iterations
+# (~31 days for 4 epochs). max_episodes_per_task=45 caps it to roughly the
+# frame count of the five single-object instructions combined -- a ~50/50 split,
+# 142 episodes, ~1,630 iterations per epoch. The cap is a no-op for the single
+# object instructions, whose largest is 25 episodes.
+SO101_MULTI_TASK = "Place each object in the plastic bin"
+
+action_policy_so101_nano_focus5_multi = copy.deepcopy(action_policy_so101_nano)
+_multi_ds = action_policy_so101_nano_focus5_multi["dataloader_train"]["dataloader"]["datasets"]["so101"]["dataset"]
+_multi_ds["keep_tasks"] = SO101_FOCUS5_TASKS + (SO101_MULTI_TASK,)
+_multi_ds["max_episodes_per_task"] = 45
+_multi_ds["val_ratio"] = 0.10
+
+
+# ---------------------------------------------------------------------------
+# Every single-object bin-placement instruction, for continued training.
+#
+# The five focus5 instructions are 97 of the dataset's 399 single-object
+# "Place the X in the plastic bin" episodes (34 instructions, 149,945 frames).
+# The other 302 teach the same grasp-lift-place skill on 29 more objects and
+# more object placements, and use the same single-object scene composition as
+# the So101Bench-Bin-v0 eval. Intended to warm-start from the merged focus5
+# checkpoint (iteration 3750), keeping its trained action heads.
+#
+# RankPartitionedDataLoader assigns each rank to exactly one dataset, so the
+# focus5 instructions cannot be upweighted with a second entry on one GPU; they
+# are ~24% of the episodes here.
+SO101_SINGLE_BIN_TASKS = (
+    "Place the altoids container in the plastic bin",
+    "Place the black glasses in the plastic bin",
+    "Place the black pen in the plastic bin",
+    "Place the black screwdriver in the plastic bin",
+    "Place the black tape in the plastic bin",
+    "Place the blue bowl in the plastic bin",
+    "Place the blue pliers in the plastic bin",
+    "Place the blue scissors in the plastic bin",
+    "Place the bowl in the plastic bin",
+    "Place the cardboard box in the plastic bin",
+    "Place the clip in the plastic bin",
+    "Place the cooking spoon in the plastic bin",
+    "Place the eraser in the plastic bin",
+    "Place the flower pot in the plastic bin",
+    "Place the glasses in the plastic bin",
+    "Place the green clip in the plastic bin",
+    "Place the green shoes in the plastic bin",
+    "Place the grey toy car in the plastic bin",
+    "Place the grey wires in the plastic bin",
+    "Place the pen in the plastic bin",
+    "Place the pink eraser in the plastic bin",
+    "Place the pliers in the plastic bin",
+    "Place the red tape in the plastic bin",
+    "Place the scissors in the plastic bin",
+    "Place the screwdriver in the plastic bin",
+    "Place the shoes in the plastic bin",
+    "Place the silver glasses in the plastic bin",
+    "Place the tape in the plastic bin",
+    "Place the toy car in the plastic bin",
+    "Place the white pen in the plastic bin",
+    "Place the wires in the plastic bin",
+    "Place the yellow screwdriver in the plastic bin",
+    "Place the yellow toy car in the plastic bin",
+    "Place the yellow wires in the plastic bin",
+)
+
+action_policy_so101_nano_single_bin = copy.deepcopy(action_policy_so101_nano)
+_single_ds = action_policy_so101_nano_single_bin["dataloader_train"]["dataloader"]["datasets"]["so101"]["dataset"]
+_single_ds["keep_tasks"] = SO101_SINGLE_BIN_TASKS
+_single_ds["val_ratio"] = 0.05
+
+
+for _item in [
+    action_policy_so101_nano,
+    action_policy_so101_nano_focus5,
+    action_policy_so101_nano_focus5_multi,
+    action_policy_so101_nano_single_bin,
+]:
+    _name = [k for k, v in globals().items() if v is _item][0]
+    cs.store(group="experiment", package="_global_", name=_name, node=_item)
