diff --git a/cosmos_framework/data/generator/action/datasets/so101_lerobot_dataset.py b/cosmos_framework/data/generator/action/datasets/so101_lerobot_dataset.py
new file mode 100644
index 0000000..0bd09f8
--- /dev/null
+++ b/cosmos_framework/data/generator/action/datasets/so101_lerobot_dataset.py
@@ -0,0 +1,291 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: OpenMDW-1.1
+
+"""SO-101 LeRobot dataset (joint-position action policy).
+
+Mirrors ``LIBEROLeRobotDataset``: reads the LeRobot parquet directly, windows
+by frame index, and decodes video at each frame's REAL timestamp (FPS-agnostic;
+``fps`` is metadata for ``conditioning_fps`` / prompt duration only). Unlike
+LIBERO, there is no relative-pose math -- a schema-matching SO-101 LeRobot v3.0
+dataset's ``action`` column is already the per-frame ABSOLUTE joint_pos target
+``[shoulder_pan, shoulder_lift, elbow_flex, wrist_flex, wrist_roll, gripper]``
+in LeRobot ``.pos`` units (verified against ``5hadytru/so101_bench_real_2`` and
+``5hadytru/so101_bench_sim_6``'s own ``meta/info.json``).
+
+Action layout follows DROID's ``action_space="joint_pos", use_state=True``
+convention (the reference ``action_policy_droid_nano`` recipe): the returned
+``action`` tensor is ``chunk_length + 1`` rows -- row 0 is the CURRENT
+``observation.state`` (what ``action_policy_server_robolab.py`` sends as
+``action[0]`` when ``--use-state`` is on), rows 1..chunk_length are the future
+target actions. This makes the video (``chunk_length + 1`` frames) and action
+tensors frame-aligned 1:1, and matches the RoboLab server's serving-side
+layout instead of leaving the model to guess the convention from an unprefixed
+``chunk_length``-row action tensor.
+
+Reading parquet/video directly (rather than
+``lerobot.datasets.lerobot_dataset.LeRobotDataset``) also sidesteps
+``so101_bench_real_2``'s missing ``codebase_version`` git tag, which otherwise
+fails ``LeRobotDataset``'s default revision resolution with
+``RevisionNotFoundError`` -- no ``revision="main"`` pin needed here.
+"""
+
+from __future__ import annotations
+
+import random
+from pathlib import Path
+from typing import Any, Literal
+
+import numpy as np
+import pyarrow.parquet as pq
+import torch
+
+from cosmos_framework.data.generator.action.action_spec import ActionSpec, Gripper, Joint, build_action_spec
+from cosmos_framework.data.generator.action.datasets.base_dataset import ActionBaseDataset
+from cosmos_framework.utils import log
+
+_ACTION_FEATURE = "action"
+_STATE_FEATURE = "observation.state"
+_IMAGE_FEATURES = ("observation.images.front", "observation.images.overhead")
+_NORMALIZERS_DIR = Path(__file__).parent.parent / "normalizer_stats"
+Split = Literal["train", "val", "valid", "validation", "eval", "test", "full"]
+
+
+class SO101LeRobotDataset(ActionBaseDataset):
+    """SO-101 (6-DOF single-arm) joint_pos action-policy dataset.
+
+    6D absolute joint_pos actions, ``concat_view`` (front-over-overhead)
+    video, minmax-normalized against SO-101's LeRobot ``.pos`` calibration
+    convention (5 body joints on ``[-100, 100]``, gripper on ``[0, 100]`` --
+    matches ``so101_bench``'s own ``SO101JointMapper`` /
+    ``REAL_SO101_CALIBRATION`` convention for the real robot).
+    """
+
+    def __init__(
+        self,
+        root: str,
+        fps: float = 30.0,
+        chunk_length: int = 32,
+        mode: str = "wam",
+        tolerance_s: float = 1e-4,
+        use_state: bool = True,
+        action_normalization: str | None = "minmax",
+        split: Split = "train",
+        val_ratio: float = 0.01,
+        seed: int = 0,
+        sample_stride: int = 1,
+        keep_tasks: tuple[str, ...] | None = None,
+        max_episodes_per_task: int | None = None,
+    ) -> None:
+        split = split.lower().strip()  # type: ignore[assignment]
+        if split not in {"train", "val", "valid", "validation", "eval", "test", "full"}:
+            raise ValueError(f"Unsupported split={split!r}. Use train/val/full.")
+
+        super().__init__(
+            root=root,
+            domain_name="so101",
+            fps=fps,
+            chunk_length=chunk_length,
+            mode=mode,
+            pose_convention="backward_framewise",  # unused for absolute joint_pos; satisfies the base assert
+            tolerance_s=tolerance_s,
+            viewpoint="concat_view",
+            action_normalization=action_normalization,
+            sample_stride=sample_stride,
+        )
+        self._use_state = use_state
+
+        # Compact, lazy frame index (mirrors LIBEROLeRobotDataset / DROIDLeRobotDataset):
+        # read only the columns the sample builder needs into contiguous arrays,
+        # ordered by global frame index, so DataLoader worker forks share them
+        # copy-on-write.
+        index_parts, episode_parts, task_parts, ts_parts, action_parts, state_parts = [], [], [], [], [], []
+        for path in sorted((self._root / "data").glob("chunk-*/file-*.parquet")):
+            table = pq.read_table(
+                path, columns=["index", "episode_index", "task_index", "timestamp", _ACTION_FEATURE, _STATE_FEATURE]
+            )
+            index_parts.append(table["index"].to_numpy())
+            episode_parts.append(table["episode_index"].to_numpy())
+            task_parts.append(table["task_index"].to_numpy())
+            ts_parts.append(table["timestamp"].to_numpy())
+            action_parts.append(np.asarray(table[_ACTION_FEATURE].to_pylist(), dtype=np.float32))
+            state_parts.append(np.asarray(table[_STATE_FEATURE].to_pylist(), dtype=np.float32))
+        if not index_parts:
+            raise FileNotFoundError(f"No data parquet found under {self._root / 'data'}.")
+        order = np.argsort(np.concatenate(index_parts).astype(np.int64), kind="stable")
+        self._row_episode = np.concatenate(episode_parts).astype(np.int64)[order]
+        self._row_task = np.concatenate(task_parts).astype(np.int64)[order]
+        self._row_timestamp = np.concatenate(ts_parts).astype(np.float64)[order]
+        self._row_action = np.concatenate(action_parts, axis=0).astype(np.float32)[order]
+        self._row_state = np.concatenate(state_parts, axis=0).astype(np.float32)[order]
+
+        assert np.all(np.diff(self._row_episode) >= 0), "episode_index not contiguous after sorting by frame index"
+        ep_vals, ep_starts, ep_counts = np.unique(self._row_episode, return_index=True, return_counts=True)
+
+        # Optional task-focus filter: keep only episodes whose instruction is in
+        # ``keep_tasks``. Applied BEFORE the train/val split so the held-out val
+        # episodes are drawn from the same focused pool the model trains on.
+        if keep_tasks:
+            wanted = {str(t) for t in keep_tasks}
+            ep_task = self._row_task[ep_starts]
+            sel = np.array([self._tasks.get(int(t), "") in wanted for t in ep_task], dtype=bool)
+            if not sel.any():
+                raise ValueError(
+                    f"keep_tasks matched no episodes. Wanted {sorted(wanted)}; "
+                    f"dataset has {len(set(self._tasks.values()))} distinct task strings."
+                )
+            ep_vals, ep_starts, ep_counts = ep_vals[sel], ep_starts[sel], ep_counts[sel]
+            log.info(f"SO-101: keep_tasks kept {int(sel.sum())} episodes across {len(wanted)} instructions")
+
+        # Optional per-instruction episode cap, applied AFTER keep_tasks and
+        # BEFORE the split. Without it a single dense instruction dominates:
+        # `Place each object in the plastic bin` alone is 875 episodes /
+        # 693,885 frames against 97 / 35,132 for the five single-object
+        # instructions, which would push one epoch from ~900 to ~16,800
+        # iterations and re-create the dilution the focused set exists to avoid.
+        # Selection is by ascending episode index -- deterministic, identical on
+        # every rank, and independent of `seed` so the train/val split stays the
+        # only source of randomness.
+        if max_episodes_per_task:
+            ep_task = self._row_task[ep_starts]
+            order_by_ep = np.argsort(ep_vals, kind="stable")
+            seen: dict[int, int] = {}
+            take = np.zeros(len(ep_vals), dtype=bool)
+            for i in order_by_ep:
+                task_id = int(ep_task[i])
+                n = seen.get(task_id, 0)
+                if n < max_episodes_per_task:
+                    take[i] = True
+                    seen[task_id] = n + 1
+            ep_vals, ep_starts, ep_counts = ep_vals[take], ep_starts[take], ep_counts[take]
+            capped = {self._tasks.get(k, str(k))[:40]: v for k, v in seen.items()}
+            log.info(
+                f"SO-101: max_episodes_per_task={max_episodes_per_task} kept "
+                f"{int(take.sum())} episodes: {capped}"
+            )
+
+        # Deterministic per-episode train/val split (seeded; same on every rank).
+        keep = self._split_episode_ids(ep_vals.tolist(), split, val_ratio, seed)
+        kept = np.array([int(v) in keep for v in ep_vals], dtype=bool)
+        self._ep_vals = ep_vals.astype(np.int64)[kept]
+        self._ep_starts = ep_starts.astype(np.int64)[kept]
+        kept_counts = ep_counts.astype(np.int64)[kept]
+        # Within-episode windows only: a window needs chunk_length + 1 frames
+        # (state/video anchor frame + chunk_length future action/video frames),
+        # so total - n_kept_episodes * chunk_length valid starts.
+        self._valid_cum = np.cumsum(np.maximum(0, kept_counts - self._chunk_length)).astype(np.int64)
+
+        log.info(
+            f"Loaded SO-101 dataset root={self._root} split={split!r} fps={self._fps} "
+            f"kept_episodes={len(self._ep_vals)}/{len(ep_vals)} "
+            f"valid_indices={int(self._valid_cum[-1]) if self._valid_cum.size else 0}"
+        )
+
+    # ---- spec / dims -------------------------------------------------------
+
+    @property
+    def action_dim(self) -> int:
+        return 6
+
+    def _action_spec(self) -> ActionSpec:
+        return build_action_spec(Joint(n=5, label="joint"), Gripper())
+
+    @classmethod
+    def _stats_path(cls) -> Path:
+        return _NORMALIZERS_DIR / "so101_lerobot_stats.json"
+
+    # ---- index helpers -----------------------------------------------------
+
+    @staticmethod
+    def _split_episode_ids(ep_ids: list[int], split: str, val_ratio: float, seed: int) -> set[int]:
+        if split == "full":
+            return set(int(v) for v in ep_ids)
+        if not (0.0 < val_ratio < 1.0):
+            raise ValueError(f"val_ratio must be in (0, 1), got {val_ratio}.")
+        n_val = max(1, int(round(len(ep_ids) * val_ratio)))
+        rng = random.Random(seed)  # identical selection on every rank
+        val = set(int(v) for v in rng.sample(list(ep_ids), n_val))
+        if split == "train":
+            return set(int(v) for v in ep_ids) - val
+        return val  # val/valid/validation/eval/test
+
+    def __len__(self) -> int:
+        return int(self._valid_cum[-1]) if self._valid_cum.size else 0
+
+    def get_shuffle_blocks(self) -> list[tuple[int, int]]:
+        """Per-episode ``(start, length)`` flat-index blocks for
+        ``ActionIterableShuffleDataset`` (shuffle block ORDER + shard across
+        ranks, sequential within a block)."""
+        blocks: list[tuple[int, int]] = []
+        prev = 0
+        for c in np.asarray(self._valid_cum).tolist():
+            c = int(c)
+            if c > prev:
+                blocks.append((prev, c - prev))
+            prev = c
+        return blocks
+
+    # ---- sample build ------------------------------------------------------
+
+    def __getitem__(self, idx: int) -> dict[str, Any]:
+        # Resample a different valid window if a frame fails to decode (bounded retries).
+        n = len(self)
+        last_err: Exception | None = None
+        for _attempt in range(8):
+            try:
+                return self._build_item(idx)
+            except Exception as e:  # noqa: BLE001 — skip past undecodable frames
+                last_err = e
+                log.warning(f"SO-101: sample idx={idx} failed to load ({type(e).__name__}: {e}); resampling")
+                if n > 0:
+                    idx = random.randint(0, n - 1)
+        raise RuntimeError(f"SO-101: failed to load a sample after 8 resamples; last error: {last_err}")
+
+    def _build_item(self, idx: int) -> dict[str, Any]:
+        mode = self._choose_mode()
+        idx = int(idx)
+        ep = int(np.searchsorted(self._valid_cum, idx, side="right"))
+        prev = int(self._valid_cum[ep - 1]) if ep > 0 else 0
+        start = int(self._ep_starts[ep]) + (idx - prev)
+        episode_index = int(self._ep_vals[ep])
+        episode = self._episodes[episode_index]
+
+        stop = start + self._chunk_length + 1
+        timestamps = [float(self._row_timestamp[j]) for j in range(start, stop)]
+        video = self._load_video(episode, timestamps)
+
+        action_future = torch.from_numpy(np.ascontiguousarray(self._row_action[start : start + self._chunk_length]))
+        action_future = action_future.float()  # [chunk_length, 6] future joint_pos targets
+        if self._use_state:
+            initial_state = torch.from_numpy(np.ascontiguousarray(self._row_state[start])).float()  # [6]
+            action = torch.cat([initial_state.unsqueeze(0), action_future], dim=0)  # [chunk_length+1, 6]
+        else:
+            action = action_future
+
+        task = self._tasks[int(self._row_task[start])]
+        ai_caption = random.choice([p.strip() for p in task.split(" | ") if p.strip()] or [task])
+
+        return self._build_result(
+            mode=mode,
+            video=video,
+            action=action,
+            ai_caption=ai_caption,
+            additional_view_description=(
+                "The top half is from the front-facing wrist camera. "
+                "The bottom half is from the fixed overhead camera."
+            ),
+        )
+
+    def _load_video(self, episode: dict[str, Any], timestamps: list[float]) -> torch.Tensor:
+        # lerobot is a heavy, optional ("train" extra) dependency; import lazily.
+        from lerobot.datasets.video_utils import decode_video_frames
+
+        frames_by_view = {}
+        for key in _IMAGE_FEATURES:
+            from_ts = float(episode.get(f"videos/{key}/from_timestamp", 0.0))
+            frames_by_view[key] = decode_video_frames(
+                self._video_path(episode, key),
+                [from_ts + ts for ts in timestamps],
+                self._tolerance_s,
+            )  # [T,C,H,W] in [0, 1]
+        # front (wrist-equivalent) over overhead -> [T,C,2H,W].
+        return torch.cat([frames_by_view[_IMAGE_FEATURES[0]], frames_by_view[_IMAGE_FEATURES[1]]], dim=-2)
