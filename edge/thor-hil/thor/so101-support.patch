diff --git a/cosmos_framework/scripts/merge_lora_dcp.py b/cosmos_framework/scripts/merge_lora_dcp.py
new file mode 100644
index 0000000..8dd17d7
--- /dev/null
+++ b/cosmos_framework/scripts/merge_lora_dcp.py
@@ -0,0 +1,176 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: OpenMDW-1.1
+
+"""Fold LoRA adapters from a trained DCP checkpoint back into the base weights.
+
+``LoraInjectedLinear`` (``cosmos_framework/utils/generator/lora.py``) keeps the
+base weight at its original ``<path>.weight`` key and stores the adapters as
+siblings ``<path>.lora_A.weight`` / ``<path>.lora_B.weight``, computing::
+
+    y = W x + (alpha / rank) * B (A x)
+
+which is exactly ``(W + (alpha / rank) * B @ A) x``. So the adapters can be
+folded in-place and dropped, yielding a checkpoint that is architecturally
+identical to a full fine-tune. That matters downstream: neither
+``cosmos_framework.scripts.export_model`` nor
+``cosmos_framework.scripts.action_policy_server_robolab`` knows about LoRA, so a
+merged checkpoint is the one that serves without any LoRA-aware rebuild.
+
+Usage::
+
+    python -m cosmos_framework.scripts.merge_lora_dcp \\
+        --input  outputs/train/<project>/<group>/<name>/checkpoints/iter_000004000 \\
+        --output outputs/train/<project>/<group>/<name>/checkpoints/iter_000004000_merged \\
+        --lora-alpha 32 --lora-rank 16
+
+``--lora-alpha`` / ``--lora-rank`` MUST match the values the run trained with
+(``[model].lora_alpha`` / ``lora_rank`` in the recipe TOML) -- the scale
+``alpha/rank`` is not recorded in the checkpoint.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import shutil
+from pathlib import Path
+
+import torch
+import torch.distributed.checkpoint as dcp
+from torch.distributed.checkpoint.format_utils import _EmptyStateDictLoadPlanner
+from torch.distributed.checkpoint.state_dict_loader import _load_state_dict
+
+from cosmos_framework.utils import log
+
+_LORA_A = ".lora_A.weight"
+_LORA_B = ".lora_B.weight"
+
+
+def _load_full_state_dict(model_dir: Path) -> dict:
+    """Read an entire DCP directory into a plain in-memory state dict.
+
+    Uses the private ``_load_state_dict`` with ``no_dist=True`` -- the same path
+    ``dcp_to_torch_save`` takes. The public ``dcp.load`` will NOT work here: it
+    populates the *keys already present* in the passed dict, so handing it an
+    empty dict reads every byte off disk and returns nothing.
+    """
+    state_dict: dict = {}
+    _load_state_dict(
+        state_dict,
+        storage_reader=dcp.FileSystemReader(str(model_dir)),
+        planner=_EmptyStateDictLoadPlanner(),
+        no_dist=True,
+    )
+    if not state_dict:
+        raise RuntimeError(f"Read no tensors from {model_dir} -- is it a valid DCP checkpoint?")
+    return state_dict
+
+
+def merge_lora_state_dict(state_dict: dict, *, lora_alpha: float, lora_rank: int) -> tuple[dict, int]:
+    """Fold every ``lora_A``/``lora_B`` pair into its sibling base weight.
+
+    Returns the merged state dict (adapter keys removed) and the number of
+    modules merged.
+    """
+    if lora_rank <= 0:
+        raise ValueError(f"lora_rank must be positive, got {lora_rank}")
+    scale = float(lora_alpha) / float(lora_rank)
+
+    prefixes = sorted(k[: -len(_LORA_A)] for k in state_dict if k.endswith(_LORA_A))
+    if not prefixes:
+        raise ValueError(
+            "No LoRA adapters found in this checkpoint (no '*.lora_A.weight' keys). "
+            "Either it was not trained with lora_enabled=true, or it is already merged."
+        )
+
+    merged = 0
+    for prefix in prefixes:
+        a_key, b_key, w_key = prefix + _LORA_A, prefix + _LORA_B, prefix + ".weight"
+        if b_key not in state_dict:
+            raise KeyError(f"{a_key} has no matching {b_key} -- checkpoint is malformed.")
+        if w_key not in state_dict:
+            raise KeyError(f"{a_key} has no matching base weight {w_key} -- checkpoint is malformed.")
+
+        a = state_dict[a_key]  # [rank, in_features]
+        b = state_dict[b_key]  # [out_features, rank]
+        w = state_dict[w_key]  # [out_features, in_features]
+
+        if a.shape[0] != lora_rank or b.shape[1] != lora_rank:
+            raise ValueError(
+                f"{prefix}: adapter rank mismatch -- checkpoint has A{tuple(a.shape)} B{tuple(b.shape)} "
+                f"but --lora-rank={lora_rank} was passed. Pass the rank the run actually trained with."
+            )
+
+        # Accumulate in fp32 regardless of the stored dtype; a bf16 accumulate
+        # of a low-magnitude delta loses most of the update.
+        delta = scale * (b.to(torch.float32) @ a.to(torch.float32))
+        if delta.shape != w.shape:
+            raise ValueError(f"{prefix}: merged delta {tuple(delta.shape)} != base weight {tuple(w.shape)}")
+        state_dict[w_key] = (w.to(torch.float32) + delta).to(w.dtype)
+
+        del state_dict[a_key]
+        del state_dict[b_key]
+        merged += 1
+
+    return state_dict, merged
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--input", required=True, help="Trained checkpoint dir (the iter_XXXXXXXXX directory).")
+    parser.add_argument("--output", required=True, help="Destination dir for the merged checkpoint.")
+    parser.add_argument("--lora-alpha", type=float, required=True, help="Must match the run's [model].lora_alpha.")
+    parser.add_argument("--lora-rank", type=int, required=True, help="Must match the run's [model].lora_rank.")
+    parser.add_argument("--overwrite", action="store_true", help="Replace --output if it already exists.")
+    args = parser.parse_args()
+
+    in_dir = Path(args.input).expanduser().resolve()
+    out_dir = Path(args.output).expanduser().resolve()
+
+    in_model = in_dir / "model" if (in_dir / "model").is_dir() else in_dir
+    if not (in_model / ".metadata").is_file():
+        raise SystemExit(f"Not a DCP checkpoint: no .metadata under {in_model}")
+    if out_dir.exists():
+        if not args.overwrite:
+            raise SystemExit(f"Output already exists: {out_dir} (pass --overwrite to replace)")
+        shutil.rmtree(out_dir)
+
+    log.info(f"[merge-lora] reading {in_model}")
+    state_dict = _load_full_state_dict(in_model)
+    log.info(f"[merge-lora] loaded {len(state_dict)} tensors")
+
+    state_dict, merged = merge_lora_state_dict(state_dict, lora_alpha=args.lora_alpha, lora_rank=args.lora_rank)
+    log.info(f"[merge-lora] merged {merged} adapter pairs at scale {args.lora_alpha / args.lora_rank:g}")
+
+    out_model = out_dir / "model"
+    out_model.mkdir(parents=True, exist_ok=True)
+    # no_dist=True: this runs as a plain single process, not under torchrun.
+    dcp.save(state_dict, storage_writer=dcp.FileSystemWriter(str(out_model)), no_dist=True)
+    log.info(f"[merge-lora] wrote {len(state_dict)} tensors to {out_model}")
+
+    # Carry over the sidecars the downstream loaders read, and record that this
+    # checkpoint no longer carries adapters.
+    for name in ("config.json", "checkpoint.json"):
+        src = in_model / name
+        if src.is_file():
+            shutil.copy2(src, out_model / name)
+    src_meta = in_dir / "checkpoint.json"
+    if src_meta.is_file():
+        shutil.copy2(src_meta, out_dir / "checkpoint.json")
+
+    cfg_path = out_model / "config.json"
+    if cfg_path.is_file():
+        try:
+            cfg = json.loads(cfg_path.read_text())
+            if isinstance(cfg, dict) and cfg.get("lora_enabled"):
+                cfg["lora_enabled"] = False
+                cfg_path.write_text(json.dumps(cfg, indent=2))
+                log.info("[merge-lora] set lora_enabled=false in the exported config.json")
+        except json.JSONDecodeError:
+            log.warning(f"[merge-lora] could not parse {cfg_path}; left as-is")
+
+    print(out_dir)
+
+
+if __name__ == "__main__":
+    main()
