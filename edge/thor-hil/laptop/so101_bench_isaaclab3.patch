diff --git a/source/so101_bench/so101_bench/utils/cosmos3.py b/source/so101_bench/so101_bench/utils/cosmos3.py
new file mode 100644
index 0000000..97bb6d7
--- /dev/null
+++ b/source/so101_bench/so101_bench/utils/cosmos3.py
@@ -0,0 +1,186 @@
+"""Cosmos3 remote-policy helpers for the SO-101 Isaac Lab environment.
+
+Mirrors utils/groot.py's GR00TRemotePolicy in every method name and signature so
+scripts/cosmos3_eval.py can reuse groot_eval.py's control flow (episode reset, robot
+control, camera snapshots, terminal controls, ...) unchanged -- only the class that
+talks to the remote policy server differs.
+
+Unlike GR00TRemotePolicy (ZeroMQ REQ/REP + msgpack, its own wire format), this talks
+openpi's WebSocket + msgpack protocol via the real `openpi_client` package
+(`openpi_client.websocket_client_policy.WebsocketClientPolicy`) -- the same protocol
+and client library `cosmos_framework.scripts.action_policy_server_robolab` speaks
+server-side (see that repo's docs/action_policy_robolab_server.md).
+
+That server applies a `1.0 - x` gripper-convention flip by default (matching DROID's
+`[0,1]` openness scale). SO-101 trains on a raw, unflipped LeRobot `.pos` gripper
+scale (`[0,100]`) -- see cosmos-framework's docs/so101_policy_finetune.md -- so the
+server MUST be launched with `--no-flip-gripper` for this domain. This client never
+applies that flip itself (`_build_request` sends `SO101JointMapper`'s raw `.pos`
+output directly), so it only round-trips correctly against a `--no-flip-gripper`
+server.
+
+Reuses SO101JointMapper and the image-conversion static helpers on GR00TRemotePolicy
+unchanged -- the sim-radians <-> LeRobot ".pos" calibration math and RGB
+normalization/resize logic don't depend on which policy server is on the other end of
+the wire, so there is no reason to duplicate them here.
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any
+
+import numpy as np
+import torch
+
+from so101_bench.utils.groot import GR00TRemotePolicy, SO101JointMapper
+
+
+def _compose_front_over_overhead(front: np.ndarray, overhead: np.ndarray) -> np.ndarray:
+    """Stack front-over-overhead vertically -- must match So101LeRobotDataset's
+    training-time composition exactly (cosmos-framework repo:
+    cosmos_framework/data/vfm/action/datasets/so101_lerobot_dataset.py,
+    registered by the action_policy_so101_nano experiment under
+    cosmos_framework/configs/base/experiment/action/posttrain_config/), or the served
+    model sees a systematically different camera layout than it was trained on.
+    """
+    if front.shape[1] != overhead.shape[1]:
+        raise ValueError(f"front/overhead width mismatch: {front.shape} vs {overhead.shape}")
+    return np.concatenate([front, overhead], axis=0)
+
+
+class Cosmos3RemotePolicy:
+    """Chunked-action Cosmos3 remote policy wrapper for the SO-101 env.
+
+    Public surface (constructor kwargs, connect/reset/get_action/
+    set_language_instruction/set_episode_initial_observation) intentionally matches
+    GR00TRemotePolicy so scripts/cosmos3_eval.py is a near-verbatim copy of
+    groot_eval.py. Cosmos3 has no working-memory-conditioned checkpoint equivalent to
+    GR00T's `overhead_init`, so `use_overhead_init` is accepted for CLI-flag
+    compatibility but is a no-op here (mirrors GR00TRemotePolicy.set_episode_initial_observation's
+    own early-return when the flag is off).
+    """
+
+    def __init__(
+        self,
+        device: str,
+        cameras: dict[str, dict[str, int]],
+        host: str = "localhost",
+        port: int = 8000,
+        action_horizon: int = 32,
+        lang_instruction: str = "Place each object in the plastic bin.",
+        rename_map: dict[str, str] | None = None,
+        use_overhead_init: bool = False,
+        overhead_init_camera: str = "overhead",
+        overhead_init_key: str = "overhead_init",
+        image_size: tuple[int, int] | None = None,
+    ):
+        if use_overhead_init:
+            raise ValueError(
+                "Cosmos3RemotePolicy has no working-memory-conditioned checkpoint equivalent to "
+                "GR00T's overhead_init -- pass --use_overhead_init false."
+            )
+        self.mapper = SO101JointMapper(device=device)
+        self.cameras = cameras
+        self.host = host
+        self.port = port
+        self.action_horizon = action_horizon
+        self.lang_instruction = lang_instruction
+        self.rename_map = rename_map or {}
+        self.use_overhead_init = use_overhead_init
+        self.overhead_init_camera = overhead_init_camera
+        self.overhead_init_key = overhead_init_key
+        # Cosmos3's server-side resize (--image-height/--image-width on
+        # action_policy_server_robolab.py) makes client-side resizing unnecessary;
+        # kept as a parameter only for interface parity with GR00TRemotePolicy.
+        self.image_size = image_size
+        self.action_queue: deque[np.ndarray] = deque()
+        self.client: Any = None
+
+    def connect(self) -> None:
+        from openpi_client import websocket_client_policy
+
+        print(f"[INFO]: Connecting to Cosmos3 policy server at {self.host}:{self.port}...")
+        self.client = websocket_client_policy.WebsocketClientPolicy(self.host, self.port)
+        print("[INFO]: Policy server connected.")
+
+    def reset(self, initial_visual_obs: dict | None = None, *, reset_remote: bool = True) -> None:
+        # action_policy_server_robolab.py is stateless per request (see cosmos-framework's
+        # docs/action_policy_robolab_server.md) -- there is no remote reset endpoint to call;
+        # `reset_remote` is accepted for interface parity with GR00TRemotePolicy.reset only.
+        del reset_remote
+        self.action_queue.clear()
+        if initial_visual_obs is not None:
+            self.set_episode_initial_observation(initial_visual_obs)
+
+    def set_language_instruction(self, instruction: str) -> None:
+        self.lang_instruction = instruction
+        self.action_queue.clear()
+
+    def set_episode_initial_observation(self, visual_obs: dict) -> None:
+        """No-op: Cosmos3 has no working-memory conditioning. Present for interface
+        parity with GR00TRemotePolicy (see class docstring)."""
+        del visual_obs
+
+    def _camera_frame(self, visual_obs: dict, camera: str, env_index: int = 0) -> np.ndarray:
+        # Reuse GR00TRemotePolicy's own RGB conversion/resize helpers rather than
+        # duplicating them -- they don't depend on which server is on the other end.
+        key = f"rgb_{camera}"
+        if key not in visual_obs:
+            raise KeyError(f"Expected visual observation key {key!r}; got: {list(visual_obs.keys())}")
+        image = visual_obs[key]
+        if isinstance(image, torch.Tensor):
+            if image.ndim >= 4:
+                image = image[env_index]
+        else:
+            image = np.asarray(image)
+            if image.ndim >= 4:
+                image = image[env_index]
+        image = GR00TRemotePolicy._to_uint8_rgb(image)
+        return GR00TRemotePolicy._resize_rgb(image, self.image_size)
+
+    def _build_request(self, joint_positions: torch.Tensor, visual_obs: dict) -> dict:
+        # sim radians -> LeRobot ".pos" space, the same space So101LeRobotDataset trained on.
+        pos = self.mapper.sim_radians_to_lerobot_positions(joint_positions).cpu().numpy().astype(np.float32)
+
+        # self.rename_map is SIM camera name -> POLICY camera name (matches
+        # GR00TRemotePolicy._sim_obs_to_groot_inputs's own convention and
+        # scripts/cosmos3_eval.py's _rename_map default of
+        # {"wrist": "front", "overhead": "overhead"} -- the sim scene's cameras are
+        # literally named camera_wrist/camera_overhead, not camera_front).
+        frames_by_policy_name: dict[str, np.ndarray] = {}
+        for sim_camera in self.cameras:
+            policy_name = self.rename_map.get(sim_camera, sim_camera)
+            if policy_name in ("front", "overhead"):
+                frames_by_policy_name[policy_name] = self._camera_frame(visual_obs, sim_camera)
+        missing = {"front", "overhead"} - frames_by_policy_name.keys()
+        if missing:
+            raise KeyError(
+                f"Cosmos3RemotePolicy needs 'front' and 'overhead' policy camera names after rename_map; "
+                f"missing {sorted(missing)}. self.cameras={list(self.cameras)} rename_map={self.rename_map}"
+            )
+        image = _compose_front_over_overhead(frames_by_policy_name["front"], frames_by_policy_name["overhead"])
+
+        return {
+            "observation/image": image,
+            "observation/joint_position": pos[:5][None, :],  # [1,5], server expects [T,arm_joint_dim]
+            "observation/gripper_position": pos[5:6][None, :],  # [1,1]
+            "prompt": self.lang_instruction,
+        }
+
+    def get_action(self, joint_positions: torch.Tensor, visual_obs: dict) -> torch.Tensor:
+        if self.client is None:
+            raise RuntimeError("Call connect() before requesting actions.")
+
+        if not self.action_queue:
+            request = self._build_request(joint_positions, visual_obs)
+            response = self.client.infer(request)
+            action_chunk = np.asarray(response["action"])  # [chunk_size, 6] in LeRobot .pos space
+            if not np.isfinite(action_chunk).all():
+                raise ValueError("Cosmos3 server returned a non-finite action chunk.")
+            horizon = min(action_chunk.shape[0], self.action_horizon)
+            self.action_queue.extend(action_chunk[:horizon])
+
+        pos_row = self.action_queue.popleft()
+        raw_tensor = torch.as_tensor(pos_row, dtype=torch.float32, device=joint_positions.device)
+        return self.mapper.lerobot_positions_to_sim_radians(raw_tensor)
