+def _spawn_room_without_env_light(
+    prim_path: str,
+    cfg: sim_utils.UsdFileCfg,
+    translation: tuple[float, float, float] | None = None,
+    orientation: tuple[float, float, float, float] | None = None,
+    **kwargs,
+) -> Usd.Prim:
+    """Spawn the room scan with its own dome light switched off.
+
+    The scan ships a near-black dome light (``env_light``, intensity 1). Isaac Sim 5.1's
+    real-time renderer summed it with the benchmark's ``BedroomDomeLight``; Isaac Sim 6's
+    Real-Time 2.0 renderer lights the scene with a single dome light and picked the black
+    one, which rendered every camera frame ~3x darker than the frames the policy was
+    trained on. With it deactivated, BedroomDomeLight is the only dome light, as intended.
+    """
+
+    prim = sim_utils.spawn_from_usd(prim_path, cfg, translation=translation, orientation=orientation, **kwargs)
+    stage = sim_utils.get_current_stage()
+    for spawned_prim_path in sim_utils.find_matching_prim_paths(prim_path):
+        root = stage.GetPrimAtPath(spawned_prim_path)
+        for child in Usd.PrimRange(root):
+            if child.GetTypeName() == "DomeLight" and os.environ.get("SO101_KEEP_ROOM_DOME_LIGHT") != "1":
+                child.SetActive(False)
+    return prim
+
